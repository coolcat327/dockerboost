{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dockerboost",
  "main": "src/api/platforms/cloudflare.ts",
  "build": {
    "command": "pnpm run build",
    "watch_dir": [
      "src/client",
      "public",
      "scripts",
      "config.js"
    ]
  },
  "compatibility_date": "2026-09-18",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "keep_vars": true
}
