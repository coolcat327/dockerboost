{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "allowJs": true,
    "noEmit": true,
    "types": ["@cloudflare/workers-types"]
  },
  "include": ["config.js", "src/**/*.ts", "edge-functions/**/*.ts"]
}
